# RADAR v6 — Variables de entorno
# Copia este archivo como .env y completa

ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=2048
REPORT_TEMPERATURE=0.5
FLASK_DEBUG=True
SECRET_KEY=radar-secret-2025
PORT=5001

# --- v8: proveedor de IA por defecto = Ollama local ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600

# --- Datos abiertos (datos.gov.co): datasets y campos en backend/app/sources.py ---
SOCRATA_DOMAIN=https://www.datos.gov.co
# Token opcional de Socrata: eleva el límite de peticiones (https://dev.socrata.com/docs/app-tokens.html)
SOCRATA_APP_TOKEN=

# --- v7: otros proveedores (opcionales) ---
# Claude, OpenAI, Gemini y DeepSeek procesan los datos fuera del servidor (transferencia internacional de datos
# personales, Ley 1581/2012 art. 26). Quedan desactivados mientras esto no sea true. Antes de activarlo,
# decláralo en la Política de tratamiento de datos (web/src/pages/Legal.jsx, sección «Transferencias»).
LLM_PERMITIR_EXTERNOS=false
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
LLAMA_BASE_URL=http://localhost:11434/v1

# --- v7: seguridad ---
REQUIRE_AUTH=false
ADMIN_USER=admin
ADMIN_PASSWORD=
ANALYST_USER=analista
ANALYST_PASSWORD=
RATE_LIMIT_PER_MIN=120
